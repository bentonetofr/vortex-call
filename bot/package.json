{
  "name": "vortex-call-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone music bot for vortex-call. Runs as its own always-on Node process (not part of the Next.js app) — deploy it to any free VM (see README.md).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build --silent && node --test test/audioInput.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.0",
    "werift": "^0.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
