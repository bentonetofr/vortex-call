# Copy to .env and fill in.

# Same Supabase project as the main app (Project settings -> API).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# A real Supabase Auth account for the bot (create it in the Supabase
# dashboard: Authentication -> Users -> Add user). The trigger that runs on
# every new signup will auto-create its members row.
BOT_EMAIL=
BOT_PASSWORD=

# The vortex-call deployment the bot fetches TURN credentials from — the
# bot is almost never on the same network as anyone, so it needs a real
# TURN relay far more often than a browser peer does.
APP_URL=https://vortex-call.vercel.app

# Path to the ffmpeg binary. Just "ffmpeg" if it's on PATH (e.g. after
# `apt install ffmpeg` on the VM).
FFMPEG_PATH=ffmpeg

# Path to yt-dlp, used to extract the audio stream from YouTube links.
# Keep yt-dlp updated because YouTube changes frequently.
YTDLP_PATH=yt-dlp

# Optional Netscape-format cookies file for videos that require a logged-in
# session (age/region restrictions). Leave empty for public videos.
YTDLP_COOKIES_PATH=
